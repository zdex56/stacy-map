{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",

    // все дальше настройки для удобства
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,


    // вроде указываю а ругается, пусть полежит в false
    "verbatimModuleSyntax": false,


    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
  }
}